{
  "name": "itoast",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "itoast",
      "version": "0.1.0",
      "license": "MIT",
      "workspaces": [
        "apps/*",
        "packages/*",
        "adapters/*",
        "plugins/*"
      ],
      "engines": {
        "node": ">=22.0.0",
        "npm": ">=11.0.0"
      }
    },
    "node_modules/@itoast/core": {
      "resolved": "packages/core",
      "link": true
    },
    "packages/core": {
      "name": "@itoast/core",
      "version": "0.1.0",
      "engines": {
        "node": ">=22.0.0"
      }
    }
  }
}
